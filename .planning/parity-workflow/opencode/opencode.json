{
  "$schema": "https://opencode.ai/config.json",
  "model": "minimax/MiniMax-M3",
  "small_model": "minimax/MiniMax-M3",
  "permission": {
    "*": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "external_directory": "deny",
    "bash": {
      "*": "deny",
      "rg *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "Get-ChildItem *": "allow",
      "Get-Content *": "allow",
      "Get-Location*": "allow",
      "Test-Path *": "allow",
      "Resolve-Path *": "allow",
      "Select-String *": "allow",
      "Where-Object *": "allow",
      "Select-Object *": "allow",
      "ForEach-Object *": "allow",
      "Measure-Object *": "allow",
      "Sort-Object *": "allow",
      "Format-Table *": "allow",
      "Format-List *": "allow",
      "javap *": "allow",
      "gofmt *": "allow",
      "go test *": "allow",
      "go vet *": "allow",
      "go build *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git grep*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow"
    }
  }
}
